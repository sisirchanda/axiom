{
  "id": "payables.payment-terms",
  "functionalArea": "Payables",
  "taskName": "Manage Payment Terms",

  "data": {
    "source": {
      "type": "excel",
      "sheet": "PaymentTerms",
      "map": {
        "Action": "Action",
        "Term Name": "termName",
        "Description": "description",
        "Due Days": "dueDays"
      },
      "required": ["termName"]
    }
  },

	"steps": [
	  { "action": "fusion.excel.loadRows" },

	  {
		"forEach": "rows",
		"do": [
		  {
			"if": { "eq": ["{{row.Action}}", "CREATE"] },
			"then": [
			  {
				"action": "fusion.generic.createRecord",
				"params": {
				  "row": "{{row}}",
				  "ui": "{{ui}}"
				}
			  }
			],
			"else": [
			  {
				"action": "core.log",
				"params": {
				  "level": "warn",
				  "message": "Skipping row Action={{row.Action}} termName={{row.termName}}"
				}
			  }
			]
		  }
		]
	  }
	]
}