{
  "id": "fusion.payables.paymentTerms.v1",

  "pre": [
    { "action": "fusion.login" },
    { "action": "fusion.openSetupAndMaintenance" },
    { "action": "fusion.openTask", "params": { "taskName": "Manage Payment Terms" } },
    {
      "action": "fusion.loadExcelRows",
      "params": {
        "sheet": "PaymentTerms",
        "map": {
          "Action": "Action",
          "Term Name": "termName",
          "Description": "description",
          "Due Days": "dueDays"
        },
        "required": ["termName"]
      }
    }
  ],

  "params": {
    "ui": {
      "createButton": { "type": "role", "role": "button", "nameRegex": "create|add|\\+" },
      "saveButton": { "type": "role", "role": "button", "nameRegex": "save" },

      "fields": [
        { "key": "termName", "fill": { "type": "label", "labelRegex": "^name$|term name" } },
        { "key": "description", "fill": { "type": "label", "labelRegex": "description" } },
        { "key": "dueDays", "fill": { "type": "label", "labelRegex": "due.*days" } }
      ]
    }
  },

  "steps": [
    {
      "forEach": "rows",
      "do": [
        {
          "if": { "eq": ["{{row.Action}}", "CREATE"] },
          "then": [
            {
              "action": "fusion.generic.createRecord",
              "params": { "row": "{{row}}", "ui": "{{params.ui}}" }
            }
          ],
          "else": [
            {
              "action": "core.log",
              "params": {
                "level": "warn",
                "message": "Skipping row Action={{row.Action}} termName={{row.termName}}"
              }
            }
          ]
        }
      ]
    }
  ]
}